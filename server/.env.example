# Scenetics server environment — copy to ".env" and fill in. Never commit .env.

# Port the API server listens on
PORT=4000

# MongoDB connection string (e.g. mongodb://localhost:27017/scenetics
# or a MongoDB Atlas URI). Server starts without it, but /api/projects
# will return 503 until this is set.
MONGODB_URI=mongodb://localhost:27017/scenetics

# Grok (xAI) API key — get one from https://console.x.ai
# Without it, POST /api/ai/generate returns 501 and the client
# uses its built-in local fallback generator.
XAI_API_KEY=

# Grok model name. Checked against xAI's line-up Oct 2026:
# 'grok-build-0.1' = coding model, cheapest — good default for generating
# component JSON. Alternatives: 'grok-4.7' (flagship), 'grok-4.5',
# 'grok-4.20', 'grok-4.3' (mid tier).
XAI_MODEL=grok-build-0.1

# Google OAuth (login is a skeleton in the MVP — see src/routes/auth.js)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session secret for when auth is fully wired
SESSION_SECRET=change-me-in-production

# Origin of the client app (CORS + post-login redirect)
CLIENT_ORIGIN=http://localhost:5173
